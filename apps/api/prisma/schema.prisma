generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String
  // true até o admin trocar a senha inicial
  mustChangePassword Boolean   @default(true)
  // incrementado a cada troca de senha: invalida sessões antigas
  tokenVersion       Int       @default(0)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  // who created this admin (null for the seeded first admin)
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

enum SaleMode {
  UNIT
  WEIGHT
}

enum ProductStatus {
  AVAILABLE
  SOLD_OUT
  HIDDEN
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  description   String
  // valor em centavos; null = "sob consulta"
  priceCents    Int?
  category      String
  weight        String?
  dimensions    String?
  origin        String?
  featured      Boolean        @default(false)
  status        ProductStatus  @default(AVAILABLE)
  // UNIT: sold by the piece (price/cost per piece, stock in stockQuantity)
  // WEIGHT: sold by the kilogram (price/cost per kg, stock in stockGrams)
  saleMode      SaleMode       @default(UNIT)
  stockQuantity Int            @default(1)
  stockGrams    Int            @default(0)
  // what the piece/kg cost the business (admin only, never exposed publicly)
  costCents     Int?
  images        ProductImage[]
  saleItems     SaleItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, featured])
  @@index([category])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // The image itself, stored in Postgres (bytea) and served by GET /images/:id
  data      Bytes
  mimeType  String
  size      Int
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

// Site-wide settings edited by the admins (single row, id = "main")
model SiteSettings {
  id        String   @id @default("main")
  // digits only, with country code (e.g. 5511999999999); empty = fall back to the web app's env default
  whatsapp  String   @default("")
  // digits only, with country code; empty = the SMS contact button is hidden on the site
  sms       String   @default("")
  // empty = the Email contact button is hidden on the site
  email     String   @default("")
  // Admin-customized WhatsApp/SMS/email message text, per language: { en: { whatsappGeneral: "...", ... }, pt: {...}, es: {...} }.
  // A key that is absent (or was cleared) falls back to the site's built-in default text for that language.
  messageTemplates Json @default("{}")
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------------ customers & sales

model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  // ISO 3166-1 alpha-2 (BR, US, ES…): the shop ships worldwide
  country      String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sales        Sale[]

  @@index([name])
}

enum SaleStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Sale {
  id                String      @id @default(cuid())
  // human-friendly order number
  number            Int         @unique @default(autoincrement())
  soldAt            DateTime    @default(now())
  status            SaleStatus  @default(PAID)
  customerId        String?
  customer          Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // snapshots: the history must not change when the customer record changes (or is erased)
  customerName      String
  shipTo            Json?
  shippingMethod    String?
  shippingCostCents Int         @default(0)
  trackingCode      String?
  paymentMethod     String
  discountCents     Int         @default(0)
  subtotalCents     Int
  totalCents        Int
  currency          String      @default("BRL")
  notes             String?
  // WhatsApp reference code that led to this sale (links clicks → conversations → sales)
  clickRef          String?
  createdById       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             SaleItem[]
  photos            SalePhoto[]

  @@index([soldAt])
  @@index([status])
  @@index([customerId])
  @@index([clickRef])
}

model SaleItem {
  id             String   @id @default(cuid())
  saleId         String
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // snapshots, so reports survive product edits/deletion
  productName    String
  category       String
  mode           SaleMode
  // UNIT: number of pieces · WEIGHT: grams
  quantity       Int
  // price per piece (UNIT) or per kilogram (WEIGHT)
  unitPriceCents Int
  costCents      Int?
  totalCents     Int

  @@index([saleId])
  @@index([productId])
}

// optional photos of what was sold/shipped (bytes in the database, admin-only)
model SalePhoto {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  @@index([saleId])
}

// ------------------------------------------------------------------ WhatsApp analytics

// One row per click on a WhatsApp button. No personal data (no IP, no user agent).
model WhatsAppClick {
  id          String    @id @default(cuid())
  // short code printed in the WhatsApp message so the admin can match the conversation
  ref         String
  source      String
  path        String
  productSlug String?
  locale      String
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@unique([ref])
  @@index([createdAt])
  @@index([productSlug])
}
