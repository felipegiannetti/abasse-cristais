generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String
  // true até o admin trocar a senha inicial
  mustChangePassword Boolean   @default(true)
  // incrementado a cada troca de senha: invalida sessões antigas
  tokenVersion       Int       @default(0)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

enum ProductStatus {
  AVAILABLE
  SOLD_OUT
  HIDDEN
}

model Product {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String
  // valor em centavos; null = "sob consulta"
  priceCents  Int?
  category    String
  weight      String?
  dimensions  String?
  origin      String?
  featured    Boolean        @default(false)
  status      ProductStatus  @default(AVAILABLE)
  images      ProductImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, featured])
  @@index([category])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // The image itself, stored in Postgres (bytea) and served by GET /images/:id
  data      Bytes
  mimeType  String
  size      Int
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}
