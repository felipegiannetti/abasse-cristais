# --- Banco de dados (Postgres) ---
# Local (docker compose up -d):
DATABASE_URL="postgresql://abasse:abasse@localhost:5432/abasse?schema=public"
# Migrations usam conexão direta. No Neon: DATABASE_URL = pooled, DIRECT_URL = unpooled.
DIRECT_URL="postgresql://abasse:abasse@localhost:5432/abasse?schema=public"

# --- Sessão do admin ---
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Em produção é obrigatório (mín. 32 caracteres aleatórios; placeholders são rejeitados).
JWT_SECRET=""

# --- Admin padrão (criado pelo seed; a senha é trocada no 1º login) ---
ADMIN_USERNAME="admin"
# Se vazia, o seed gera uma senha aleatória e a exibe uma única vez (não existe senha padrão).
ADMIN_INITIAL_PASSWORD=""

# Mesmo valor do ADMIN_LOGIN_TOKEN do site (endereço secreto do login). Sem ele o login fica DESATIVADO.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_LOGIN_TOKEN=""

# Quantos proxies confiáveis existem na frente da API (Vercel = 1). Nunca use valores maiores que o real.
TRUST_PROXY_HOPS="1"

# --- Origem(ns) permitidas do site (proteção CSRF por checagem de Origin) ---
WEB_ORIGIN="http://localhost:3000"
