# --- Banco de dados (Postgres) ---
# Local (docker compose up -d):
DATABASE_URL="postgresql://abasse:abasse@localhost:5432/abasse?schema=public"
# Migrations usam conexão direta. No Neon: DATABASE_URL = pooled, DIRECT_URL = unpooled.
DIRECT_URL="postgresql://abasse:abasse@localhost:5432/abasse?schema=public"

# --- Sessão do admin ---
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Em produção é obrigatório (mín. 32 caracteres).
JWT_SECRET="troque-esta-chave-em-desenvolvimento"

# --- Admin padrão (criado pelo seed; a senha é trocada no 1º login) ---
ADMIN_USERNAME="admin"
# Obrigatória em produção. Em dev, se vazia, usa "Abasse@Inicial1".
ADMIN_INITIAL_PASSWORD=""

# --- Origem(ns) permitidas do site (proteção CSRF por checagem de Origin) ---
WEB_ORIGIN="http://localhost:3000"

# --- Imagens ---
# Vercel Blob (obrigatório em produção). Sem token, em dev as imagens vão para ./uploads.
BLOB_READ_WRITE_TOKEN=""
