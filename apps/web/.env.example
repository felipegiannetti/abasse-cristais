# URL do backend NestJS (usada pelo servidor do Next e pelo proxy /api/*)
API_URL="http://localhost:4000"

# WhatsApp PADRÃO (só dígitos, país + DDD, ex.: 5511999999999). O número de verdade é configurado no painel (Configurações) e substitui este valor.
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999999999"

# URL pública do site (SEO, sitemap e links compartilhados no WhatsApp)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Endereço secreto do login do admin: o login abre em  SEU-SITE/<ADMIN_LOGIN_TOKEN>
# (/admin sem sessão responde 404). 16-128 caracteres: letras, números, "-" ou "_".
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_LOGIN_TOKEN=""

# Identificação da empresa (rodapé e política de privacidade). O que ficar vazio simplesmente não aparece.
NEXT_PUBLIC_LEGAL_NAME=""
NEXT_PUBLIC_LEGAL_CNPJ=""
NEXT_PUBLIC_LEGAL_ADDRESS=""
